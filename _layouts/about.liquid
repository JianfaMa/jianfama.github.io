---
layout: default
---
<div class="post about-page">
  <article>
    <section class="about-hero" aria-labelledby="about-title">
      <div class="about-hero-content">
        <p class="about-kicker">{{ page.subtitle }}</p>
        <h1 id="about-title" class="about-name">
          {% if site.title == 'blank' %}
            <span class="font-weight-bold">{{ site.first_name }}</span> {{ site.middle_name }}
            {{ site.last_name }}
          {% else %}
            {{ site.title }}
          {% endif %}
        </h1>
        <h2 class="about-role">{{ page.role_title }}</h2>
        <p class="about-target">
          <span>{{ page.career_target.primary }}</span>
          <span>{{ page.career_target.secondary }}</span>
        </p>
        <div class="about-summary">{{ content }}</div>
      </div>

      {% if page.profile and page.profile.image %}
        <div class="about-hero-profile">
          {% assign profile_image_path = page.profile.image | prepend: 'assets/img/' %}
          {% if page.profile.image_circular %}
            {% assign profile_image_class = 'img-fluid rounded-circle' %}
          {% else %}
            {% assign profile_image_class = 'img-fluid rounded' %}
          {% endif %}
          {% capture sizes %}(min-width: {{ site.max_width }}) 280px, (min-width: 768px) 32vw, 82vw{% endcapture %}
          {%
            include figure.liquid loading="eager" path=profile_image_path class=profile_image_class sizes=sizes
            alt=page.profile.image_alt cache_bust=true
          %}
          <div class="profile-caption">
            <span class="profile-caption-dot" aria-hidden="true"></span>
            Shenzhen · Hong Kong · Guangzhou
          </div>
        </div>
      {% endif %}
    </section>

    {% if page.show_education and page.education %}
      <h2>Education</h2>
      <div class="education-list">
        {% for edu in page.education %}
          <div class="education-item">
            {% if edu.logo %}
              <div class="education-logo">
                {% assign education_logo_path = edu.logo | prepend: 'assets/img/' %}
                {% include figure.liquid path=education_logo_path class="education-logo-image" width="80" sizes="80px" alt=edu.logo_alt loading="eager" %}
              </div>
            {% endif %}
            <div class="education-content">
              {% for line in edu.lines %}
                <p>{{ line | markdownify | remove: '<p>' | remove: '</p>' }}</p>
              {% endfor %}
            </div>
          </div>
        {% endfor %}
      </div>
    {% endif %}

    {% if page.show_research_visiting_experience and page.research_visiting_experience %}
      <h2>Research and Visiting Experience</h2>
      <div class="education-list">
        {% for exp in page.research_visiting_experience %}
          <div class="education-item">
            {% if exp.logo %}
              <div class="education-logo">
                {% assign experience_logo_path = exp.logo | prepend: 'assets/img/' %}
                {% include figure.liquid path=experience_logo_path class="education-logo-image" width="80" sizes="80px" alt=exp.logo_alt loading="eager" %}
              </div>
            {% endif %}
            <div class="education-content">
              {% for line in exp.lines %}
                <p>{{ line | markdownify | remove: '<p>' | remove: '</p>' }}</p>
              {% endfor %}
            </div>
          </div>
        {% endfor %}
      </div>
    {% endif %}

    {% if page.show_publications %}
      <h2>Publications</h2>
      <div class="publications">
        {% bibliography --group_by none %}
      </div>
    {% endif %}

    {% if page.show_awards and page.awards %}
      <h2>Awards & Honors</h2>
      <div class="education-list">
        {% for award in page.awards %}
          <div class="education-item">
            {% if award.logo %}
              <div class="education-logo award-logo">
                {% assign award_logo_path = award.logo | prepend: 'assets/img/' %}
                {% include figure.liquid path=award_logo_path class="education-logo-image" width="200" sizes="200px" alt=award.logo_alt loading="eager" %}
              </div>
            {% endif %}
            <div class="education-content">
              {% for line in award.lines %}
                <p>{{ line | markdownify | remove: '<p>' | remove: '</p>' }}</p>
              {% endfor %}
            </div>
          </div>
        {% endfor %}
      </div>
    {% endif %}

    <!-- Social -->
    {% if page.social %}
      <div class="social">
        <div class="contact-icons">
          {% social_links %}
        </div>
        {% if site.contact_note != blank %}
          <div class="contact-note">{{ site.contact_note }}</div>
        {% endif %}
      </div>
    {% endif %}

    {% if site.newsletter and site.newsletter.enabled and site.footer_fixed %}
      {% include newsletter.liquid center=true %}
    {% endif %}
  </article>
</div>
