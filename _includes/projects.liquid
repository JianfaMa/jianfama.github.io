<div class="col">
  <article class="card h-100 project-card">
    {% if project.img %}
      {%
        include figure.liquid
        loading="eager"
        path=project.img
        sizes = "(min-width: 768px) 420px, 92vw"
        alt=project.image_alt
        class="card-img-top"
      %}
    {% endif %}
    <div class="card-body">
      <div class="project-card-topline">
        {% if project.status -%}
          <span class="project-status">{{ project.status }}</span>
        {%- endif %}
        {% if project.period -%}
          <small>{{ project.period }}</small>
        {%- endif %}
      </div>
      <h2 class="card-title">{{ project.title }}</h2>
      <p class="card-text">{{ project.description }}</p>
      {% if project.card_highlights %}
        <ul class="project-highlight-list">
          {% for highlight in project.card_highlights %}
            <li>{{ highlight }}</li>
          {% endfor %}
        </ul>
      {% endif %}
      {% if project.skills %}
        <div class="project-tags" aria-label="Technologies">
          {% for skill in project.skills %}
            <span class="project-tag">{{ skill }}</span>
          {% endfor %}
        </div>
      {% endif %}
      <div class="project-card-footer">
        <a class="project-card-link" href="{{ project.url | relative_url }}">View case study <i class="fa-solid fa-arrow-right"></i></a>
        {% if project.github %}
          <a href="{{ project.github }}" aria-label="{{ project.title }} code repository"><i class="fa-brands fa-github"></i> Code</a>
        {% endif %}
      </div>
    </div>
  </article>
</div>
