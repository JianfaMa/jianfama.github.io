<header>
  <!-- Nav Bar -->
  <nav id="navbar" class="navbar navbar-light navbar-expand-md {% if site.navbar_fixed %}fixed-top{% else %}sticky-top{% endif %}" role="navigation">
    <div class="container">
      <a class="navbar-brand site-brand" href="{{ '/' | relative_url }}" aria-label="Jianfa Ma home">
        <span class="brand-mark" aria-hidden="true">JM</span>
        <span class="brand-copy">
          <span class="brand-name">
            {{- site.first_name }}
            {{ site.last_name -}}
          </span>
          <span class="brand-role">Embodied AI · Robotics</span>
        </span>
      </a>
      <!-- Navbar Toggle -->
      <button
        class="navbar-toggler collapsed ml-auto"
        type="button"
        data-toggle="collapse"
        data-target="#navbarNav"
        aria-controls="navbarNav"
        aria-expanded="false"
        aria-label="Toggle navigation"
      >
        <span class="sr-only">Toggle navigation</span>
        <span class="icon-bar top-bar"></span>
        <span class="icon-bar middle-bar"></span>
        <span class="icon-bar bottom-bar"></span>
      </button>

      <div class="collapse navbar-collapse text-right" id="navbarNav">
        <ul class="navbar-nav ml-auto flex-nowrap">
          {% for page in site.pages %}
            {% if page.title == 'CV' %}
              {% assign cv_page = page %}
            {% endif %}
          {% endfor %}

          <!-- About -->
          <li class="nav-item {% if page.permalink == '/' %}active{% endif %}">
            <a
              class="nav-link"
              href="{{ '/' | relative_url }}"
              {% if page.permalink == '/' %}
                aria-current="page"
              {% endif %}
            >
              About
              {% if page.permalink == '/' %}
                <span class="sr-only">(current)</span>
              {% endif %}
            </a>
          </li>

          <!-- Projects -->
          <li class="nav-item {% if page.permalink == '/projects/' %}active{% endif %}">
            <a
              class="nav-link"
              href="{{ '/projects/' | relative_url }}"
              {% if page.permalink == '/projects/' %}
                aria-current="page"
              {% endif %}
            >
              Projects
              {% if page.permalink == '/projects/' %}
                <span class="sr-only">(current)</span>
              {% endif %}
            </a>
          </li>

          {% if cv_page and cv_page.cv_pdf %}
            <li class="nav-item">
              {% if cv_page.cv_pdf contains '://' %}
                {% assign cv_url = cv_page.cv_pdf %}
              {% else %}
                {% assign cv_url = cv_page.cv_pdf | relative_url %}
              {% endif %}
              <a class="nav-link nav-cv-link" href="{{ cv_url }}" target="_blank" rel="noopener noreferrer">
                <i class="fa-solid fa-file-arrow-down" aria-hidden="true"></i>
                CV
              </a>
            </li>
          {% endif %}
          {% if site.enable_darkmode %}
            <!-- Toogle theme mode -->
            <li class="toggle-container">
              <button id="light-toggle" title="Switch color theme" aria-label="Switch color theme">
                <i class="fa-half-sun-moon" id="light-toggle-system"></i>
                <i class="fa-solid fa-moon" id="light-toggle-dark"></i>
                <i class="fa-solid fa-sun" id="light-toggle-light"></i>
              </button>
            </li>
          {% endif %}
        </ul>
      </div>
    </div>
  </nav>
  {% if site.enable_progressbar %}
    <!-- Scrolling Progress Bar -->
    <progress id="progress" value="0">
      <div class="progress-container">
        <span class="progress-bar"></span>
      </div>
    </progress>
  {% endif %}
</header>
